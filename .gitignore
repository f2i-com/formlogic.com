# Root repo tracks formlogic/. Build artifacts and dependencies are ignored by
# formlogic/.gitignore. (The old engine source repos formlogic-php and
# formlogic-rust were removed — the scripting engine is ZIPP, and neither of its
# builds is committed: the browser engine, formlogic/ui/vendor/zipp-wasm/, is the
# installed Softn release's zipp/ tree (scripts/fetch-softn-release.mjs), and the
# server sandbox (formlogic/runtime/ builds it; backend/bin/runtime/ holds the
# launchers) is built from the ZIPP release that Softn release names
# (scripts/build-runtime.sh, or CI).)

# Playwright output (any location)
test-results/
playwright-report/
**/test-results/
**/playwright-report/
dist-package/

# Session resume notes (local only — full status for picking up in a new session)
CLAUDE.md
AGENTS.md

# Root-level node_modules (stray tool installs land here; the real one lives in formlogic/ui)
node_modules/

# Isolated local booking test database files
formlogic/backend/storage/booking-test/

# Generated runtime inputs: the installed Softn release (softn-release/), the
# ZIPP source the server sandbox is built from (zipp/) and its build records (sandbox/)
.runtime-source/

# Default output of the release-key generator (keep private keys outside Git).
/formlogic-release-signing.pem

# Generated shared native app runtime; rebuild with node scripts/prepare-native-runtime.mjs
/formlogic/backend/resources/softn-native/
/formlogic/backend/storage/native-apps/

/formlogic/ui/public/app-editors/
/formlogic/ui/public/.app-editors-*/

# Generated browser engine (the installed Softn release's zipp/ tree, with its
# staging and .previous siblings); scripts/engine-provenance-guard.mjs fails on
# anything tracked here. The zip's zipp-licenses.txt is written by
# scripts/package-dist.mjs, no longer kept in public/.
/formlogic/ui/vendor/
/formlogic/ui/public/zipp-licenses.txt

# Generated server sandbox: the launchers scripts/build-runtime.sh (or a CI run)
# builds from the ZIPP release the installed Softn release names, and the
# SOURCE.json provenance it writes beside them. The guard fails on a tracked binary.
/formlogic/backend/bin/runtime/

# Private hosted app databases created by local/runtime use
/formlogic/backend/storage/hosted-apps/

# Operator-managed form starters (preserved during upgrades, not shipped as defaults)
/formlogic/backend/storage/form-templates/

# Operator-maintained app pack folders survive deployments.
formlogic/backend/storage/pack-projects/
