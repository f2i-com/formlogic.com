{
  "formatVersion": 1,
  "packMeta": {
    "name": "Sales CRM",
    "description": "Client CRM and sales pipeline demo — Contacts, Deals, and Activities with a live dashboard custom screen.",
    "version": "1.0.0",
    "tags": [
      "demo",
      "crm",
      "sales"
    ]
  },
  "forms": [
    {
      "packFormId": "contact-form",
      "title": "Contact",
      "description": "People and companies in your book of business.",
      "icon": "Users",
      "settings": [],
      "theme": [],
      "logicScript": "",
      "fields": [
        {
          "id": "name",
          "type": "short_text",
          "label": "Full name",
          "required": true,
          "properties": {
            "placeholder": "Jane Doe"
          }
        },
        {
          "id": "email",
          "type": "email",
          "label": "Email",
          "required": true,
          "properties": {
            "placeholder": "jane@acme.com"
          }
        },
        {
          "id": "company",
          "type": "short_text",
          "label": "Company",
          "required": false,
          "properties": {
            "placeholder": "Acme Inc."
          }
        },
        {
          "id": "phone",
          "type": "phone",
          "label": "Phone",
          "required": false,
          "properties": []
        }
      ],
      "customScreen": {
        "enabled": true,
        "allowNewResponses": true,
        "kind": "dashboard",
        "dashboard": {
          "version": 1,
          "cols": 12,
          "widgets": [
            {
              "id": "k1",
              "title": "Total contacts",
              "layout": {
                "x": 0,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:contact-form",
                "viz": "kpi",
                "measure": {
                  "fn": "count"
                }
              }
            },
            {
              "id": "k2",
              "title": "Companies",
              "layout": {
                "x": 3,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:contact-form",
                "viz": "kpi",
                "measure": {
                  "fn": "countDistinct",
                  "field": "company"
                }
              }
            },
            {
              "id": "c1",
              "title": "New contacts over time",
              "layout": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:contact-form",
                "viz": "area",
                "groupBy": {
                  "field": "__submitted_at",
                  "bucket": "month"
                },
                "measure": {
                  "fn": "count"
                },
                "seriesSort": "label",
                "limit": 12
              }
            },
            {
              "id": "c2",
              "title": "Top companies",
              "layout": {
                "x": 0,
                "y": 1,
                "w": 6,
                "h": 2
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:contact-form",
                "viz": "bar",
                "groupBy": {
                  "field": "company",
                  "bucket": "none"
                },
                "measure": {
                  "fn": "count"
                },
                "seriesSort": "value",
                "sort": "desc",
                "limit": 8
              }
            },
            {
              "id": "l1",
              "title": "Recent contacts",
              "layout": {
                "x": 0,
                "y": 3,
                "w": 12,
                "h": 3
              },
              "kind": "list",
              "list": {
                "formId": "@pack:contact-form",
                "titleField": "name",
                "subtitleField": "company",
                "limit": 8
              }
            }
          ]
        }
      }
    },
    {
      "packFormId": "deal-form",
      "title": "Deal",
      "description": "Opportunities in your sales pipeline.",
      "icon": "DollarSign",
      "settings": [],
      "theme": [],
      "logicScript": "function onSubmit(ctx) {\n  // New deals default to the 'Lead' stage when none is chosen.\n  if (!ctx.answers.stage) {\n    ctx.answers.stage = 'lead';\n  }\n}\n",
      "fields": [
        {
          "id": "title",
          "type": "short_text",
          "label": "Deal title",
          "required": true,
          "properties": {
            "placeholder": "Acme - annual plan"
          }
        },
        {
          "id": "amount",
          "type": "number",
          "label": "Amount (USD)",
          "required": true,
          "properties": {
            "min": 0,
            "placeholder": "5000"
          }
        },
        {
          "id": "stage",
          "type": "dropdown",
          "label": "Stage",
          "required": true,
          "properties": {
            "options": [
              {
                "id": "lead",
                "label": "Lead",
                "value": "lead"
              },
              {
                "id": "qualified",
                "label": "Qualified",
                "value": "qualified"
              },
              {
                "id": "proposal",
                "label": "Proposal",
                "value": "proposal"
              },
              {
                "id": "won",
                "label": "Won",
                "value": "won"
              },
              {
                "id": "lost",
                "label": "Lost",
                "value": "lost"
              }
            ]
          }
        },
        {
          "id": "close_date",
          "type": "date",
          "label": "Expected close date",
          "required": false,
          "properties": []
        },
        {
          "id": "contact",
          "type": "linked_record",
          "label": "Contact",
          "required": true,
          "properties": {
            "targetFormId": "@pack:contact-form"
          }
        }
      ],
      "customScreen": {
        "enabled": true,
        "allowNewResponses": true,
        "kind": "dashboard",
        "dashboard": {
          "version": 1,
          "cols": 12,
          "widgets": [
            {
              "id": "k1",
              "title": "Total deals",
              "layout": {
                "x": 0,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:deal-form",
                "viz": "kpi",
                "measure": {
                  "fn": "count"
                }
              }
            },
            {
              "id": "k2",
              "title": "Pipeline value",
              "layout": {
                "x": 3,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:deal-form",
                "viz": "kpi",
                "measure": {
                  "fn": "sum",
                  "field": "amount"
                }
              }
            },
            {
              "id": "k3",
              "title": "Avg deal size",
              "layout": {
                "x": 6,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:deal-form",
                "viz": "kpi",
                "measure": {
                  "fn": "avg",
                  "field": "amount"
                }
              }
            },
            {
              "id": "k4",
              "title": "Won deals",
              "layout": {
                "x": 9,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:deal-form",
                "viz": "kpi",
                "measure": {
                  "fn": "count"
                },
                "filters": [
                  {
                    "field": "stage",
                    "op": "eq",
                    "value": "won"
                  }
                ]
              }
            },
            {
              "id": "c1",
              "title": "Value by stage",
              "layout": {
                "x": 0,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:deal-form",
                "viz": "bar",
                "groupBy": {
                  "field": "stage",
                  "bucket": "none"
                },
                "measure": {
                  "fn": "sum",
                  "field": "amount"
                },
                "seriesSort": "value",
                "sort": "desc"
              }
            },
            {
              "id": "c2",
              "title": "Deals by stage",
              "layout": {
                "x": 6,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:deal-form",
                "viz": "donut",
                "groupBy": {
                  "field": "stage",
                  "bucket": "none"
                },
                "measure": {
                  "fn": "count"
                },
                "limit": 6
              }
            },
            {
              "id": "c3",
              "title": "New deals over time",
              "layout": {
                "x": 0,
                "y": 4,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:deal-form",
                "viz": "area",
                "groupBy": {
                  "field": "__submitted_at",
                  "bucket": "month"
                },
                "measure": {
                  "fn": "count"
                },
                "seriesSort": "label",
                "limit": 12
              }
            },
            {
              "id": "l1",
              "title": "Recent deals",
              "layout": {
                "x": 6,
                "y": 4,
                "w": 6,
                "h": 3
              },
              "kind": "list",
              "list": {
                "formId": "@pack:deal-form",
                "titleField": "title",
                "subtitleField": "stage",
                "limit": 8
              }
            }
          ]
        }
      }
    },
    {
      "packFormId": "activity-form",
      "title": "Activity",
      "description": "Calls, emails, and meetings logged against a contact.",
      "icon": "CalendarClock",
      "settings": [],
      "theme": [],
      "logicScript": "",
      "fields": [
        {
          "id": "subject",
          "type": "short_text",
          "label": "Subject",
          "required": true,
          "properties": {
            "placeholder": "Intro call"
          }
        },
        {
          "id": "notes",
          "type": "long_text",
          "label": "Notes",
          "required": false,
          "properties": {
            "placeholder": "What was discussed…"
          }
        },
        {
          "id": "type",
          "type": "dropdown",
          "label": "Type",
          "required": true,
          "properties": {
            "options": [
              {
                "id": "call",
                "label": "Call",
                "value": "call"
              },
              {
                "id": "email",
                "label": "Email",
                "value": "email"
              },
              {
                "id": "meeting",
                "label": "Meeting",
                "value": "meeting"
              }
            ]
          }
        },
        {
          "id": "contact",
          "type": "linked_record",
          "label": "Contact",
          "required": true,
          "properties": {
            "targetFormId": "@pack:contact-form"
          }
        },
        {
          "id": "date",
          "type": "date",
          "label": "Date",
          "required": false,
          "properties": []
        }
      ],
      "customScreen": {
        "enabled": true,
        "allowNewResponses": true,
        "kind": "dashboard",
        "dashboard": {
          "version": 1,
          "cols": 12,
          "widgets": [
            {
              "id": "k1",
              "title": "Total activities",
              "layout": {
                "x": 0,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:activity-form",
                "viz": "kpi",
                "measure": {
                  "fn": "count"
                }
              }
            },
            {
              "id": "k2",
              "title": "Contacts touched",
              "layout": {
                "x": 3,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:activity-form",
                "viz": "kpi",
                "measure": {
                  "fn": "countDistinct",
                  "field": "contact"
                }
              }
            },
            {
              "id": "c1",
              "title": "Activity over time",
              "layout": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:activity-form",
                "viz": "area",
                "groupBy": {
                  "field": "__submitted_at",
                  "bucket": "month"
                },
                "measure": {
                  "fn": "count"
                },
                "seriesSort": "label",
                "limit": 12
              }
            },
            {
              "id": "c2",
              "title": "By type",
              "layout": {
                "x": 0,
                "y": 1,
                "w": 6,
                "h": 2
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:activity-form",
                "viz": "bar",
                "groupBy": {
                  "field": "type",
                  "bucket": "none"
                },
                "measure": {
                  "fn": "count"
                },
                "seriesSort": "value",
                "sort": "desc",
                "limit": 6
              }
            },
            {
              "id": "l1",
              "title": "Recent activity",
              "layout": {
                "x": 0,
                "y": 3,
                "w": 12,
                "h": 3
              },
              "kind": "list",
              "list": {
                "formId": "@pack:activity-form",
                "titleField": "subject",
                "subtitleField": "type",
                "limit": 8
              }
            }
          ]
        }
      }
    }
  ],
