              "id": "c1",
              "title": "Tasks by category",
              "layout": {
                "x": 0,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:onboarding-task",
                "viz": "bar",
                "groupBy": {
