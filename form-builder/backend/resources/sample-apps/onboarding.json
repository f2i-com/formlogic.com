{
  "formatVersion": 1,
  "packMeta": {
    "name": "People Onboarding & Compliance",
    "description": "A complete employee onboarding + compliance app: employees, onboarding tasks, and policy acknowledgements, with a live completion & compliance dashboard.",
    "version": "1.0.0",
    "tags": [
      "demo",
      "hr",
      "onboarding",
      "compliance"
    ]
  },
  "forms": [
    {
      "packFormId": "employee",
      "title": "Employee",
      "description": "New hires and their department + start date.",
      "icon": "UserPlus",
      "settings": [],
      "theme": [],
      "fields": [
        {
          "id": "full_name",
          "type": "short_text",
          "label": "Full name",
          "required": true,
          "properties": []
        },
        {
          "id": "email",
          "type": "email",
          "label": "Work email",
          "required": true,
          "properties": []
        },
        {
          "id": "department",
          "type": "dropdown",
          "label": "Department",
          "required": true,
          "properties": {
            "options": [
              {
                "id": "engineering",
                "label": "Engineering",
                "value": "engineering"
              },
              {
                "id": "sales",
                "label": "Sales",
                "value": "sales"
              },
              {
                "id": "hr",
                "label": "HR",
                "value": "hr"
              },
              {
                "id": "finance",
                "label": "Finance",
                "value": "finance"
              },
              {
                "id": "ops",
                "label": "Operations",
                "value": "ops"
              }
            ]
          }
        },
        {
          "id": "start_date",
          "type": "date",
          "label": "Start date",
          "required": true,
          "properties": []
        }
      ],
      "customScreen": {
        "enabled": true,
        "allowNewResponses": true,
        "kind": "dashboard",
        "dashboard": {
          "version": 1,
          "cols": 12,
          "widgets": [
            {
              "id": "k1",
              "title": "Employees",
              "layout": {
                "x": 0,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:employee",
                "viz": "kpi",
                "measure": {
                  "fn": "count"
                }
              }
            },
            {
              "id": "k2",
              "title": "Departments",
              "layout": {
                "x": 3,
                "y": 0,
                "w": 3,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:employee",
                "viz": "kpi",
                "measure": {
                  "fn": "countDistinct",
                  "field": "department"
                }
              }
            },
            {
              "id": "c1",
              "title": "Employees by department",
              "layout": {
                "x": 0,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:employee",
                "viz": "bar",
                "groupBy": {
                  "field": "department",
                  "bucket": "none"
                },
                "measure": {
                  "fn": "count"
                },
                "seriesSort": "value",
                "sort": "desc",
                "limit": 8
              }
            },
            {
              "id": "c2",
              "title": "Start dates by month",
              "layout": {
                "x": 6,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:employee",
                "viz": "area",
                "groupBy": {
                  "field": "start_date",
                  "bucket": "month"
                },
                "measure": {
                  "fn": "count"
                },
                "seriesSort": "label",
                "limit": 12
              }
            },
            {
              "id": "l1",
              "title": "Recent employees",
              "layout": {
                "x": 0,
                "y": 4,
                "w": 12,
                "h": 3
              },
              "kind": "list",
              "list": {
                "formId": "@pack:employee",
                "titleField": "full_name",
                "subtitleField": "department",
                "limit": 6
              }
            }
          ]
        }
      }
    },
