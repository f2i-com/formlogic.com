                "x": 0,
                "y": 4,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:onboarding-task",
                "viz": "area",
                "groupBy": {
                  "field": "__submitted_at",
                  "bucket": "month"
                },
                "measure": {
                  "fn": "count"
                },
                "seriesSort": "label",
                "limit": 12
              }
            },
            {
              "id": "l1",
              "title": "Recent tasks",
              "layout": {
