# =============================================================================
# FormLogic Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# DO NOT commit .env to version control.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Environment: "production" or "development"
APP_ENV=development

# Show detailed error messages (set to "true" only in development)
APP_DEBUG=true

# -----------------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=formlogic
DB_USERNAME=formlogic

# Set your database user password (REQUIRED in production)
DB_PASSWORD=

# -----------------------------------------------------------------------------
# SQLite Storage
# -----------------------------------------------------------------------------
# Relative path from backend/ for per-form SQLite databases
SQLITE_STORAGE_PATH=storage/forms

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a secure secret (minimum 32 characters). REQUIRED in production.
#   openssl rand -base64 32
# The install script generates this automatically.
JWT_SECRET=

# Token lifetime in seconds (default: 86400 = 24 hours)
JWT_EXPIRY=86400

# JWT issuer and audience claims
JWT_ISSUER=formlogic
JWT_AUDIENCE=formlogic-api

# -----------------------------------------------------------------------------
# Cookie
# -----------------------------------------------------------------------------
# Cookie domain (empty = current domain only)
# For production with a specific domain, e.g.: .example.com
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Primary allowed origin for CORS headers
CORS_ORIGIN=http://localhost:5173

# Additional allowed origins (comma-separated, optional)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Maximum login attempts before lockout
LOGIN_MAX_ATTEMPTS=5

# Lockout duration in minutes
LOGIN_DECAY_MINUTES=15

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# Maximum upload file size in bytes (default: 10MB)
UPLOAD_MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# Trusted Proxies (optional)
# -----------------------------------------------------------------------------
# Comma-separated list of trusted proxy IPs or CIDR ranges
# Required if behind a reverse proxy to get accurate client IPs
# Example: TRUSTED_PROXIES=10.0.0.0/8,172.16.0.1
# TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# AI Services (optional)
# -----------------------------------------------------------------------------
# AI form generation uses an OpenAI-compatible API (OpenAI, Azure OpenAI, or a
# local/self-hosted LLM gateway). Set OPENAI_API_KEY to enable the AI features;
# leave it blank to disable them. The URL/model vars are optional overrides.
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Email (transactional: password resets, invitations, response notifications)
# -----------------------------------------------------------------------------
# Set MAIL_FROM_ADDRESS to enable outbound email. With SMTP_HOST set, mail is
# sent via SMTP (requires `composer require symfony/mailer`); otherwise the
# server falls back to PHP mail(). If unset, email features degrade gracefully
# (e.g. invitations still produce a copyable link) — nothing breaks.
# MAIL_FROM_ADDRESS=noreply@yourdomain.com
# MAIL_FROM_NAME=FormLogic
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=tls
# APP_URL=https://yourdomain.com   # used to build links in emails (else derived from request)

# -----------------------------------------------------------------------------
# Audit Trail
# -----------------------------------------------------------------------------
# HMAC key for audit log integrity verification (REQUIRED in production)
# The install script generates this automatically.
# AUDIT_HMAC_KEY=
