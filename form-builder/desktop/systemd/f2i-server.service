[Unit]
Description=F2I server (headless companion — services/models/python API on 127.0.0.1:17872)
Documentation=https://f2i.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated unprivileged user you create:
#   useradd --system --shell /usr/sbin/nologin f2i
# (StateDirectory below auto-creates /var/lib/f2i owned by f2i — no manual mkdir.)
User=f2i
Group=f2i

# All state lives under one dir (databases, venvs, downloaded models, templates).
Environment=F2I_DATA_DIR=/var/lib/f2i
Environment=F2I_MODELS_DIR=/var/lib/f2i/models
# Bind port (loopback only). Front with nginx/Caddy + TLS if exposed.
Environment=F2I_SERVER_PORT=17872
# Set a long random token to allow privileged admin calls (define service /
# install python / create venv) from the CLI: Authorization: Bearer <token>.
# Leave empty to keep privileged routes closed to non-browser callers.
Environment=F2I_SERVER_TOKEN=
# Optional: HuggingFace token for gated model downloads.
# Environment=F2I_HF_TOKEN=

ExecStart=/usr/local/bin/f2i-server
Restart=on-failure
RestartSec=3

# f2i-server stops every managed service on SIGTERM before exiting.
KillSignal=SIGTERM
TimeoutStopSec=30

# State dir: systemd auto-creates /var/lib/f2i (+ /var/lib/f2i/models) owned by
# f2i:f2i at 0700 on first start, and keeps it writable under ProtectSystem=strict
# — so no manual mkdir/chown and no separate ReadWritePaths is needed.
StateDirectory=f2i f2i/models
StateDirectoryMode=0700

# Hardening (relax if a managed service needs more).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
