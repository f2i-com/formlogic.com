# =============================================================================
# FormLogic Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.

# Backend API URL
# For development with separate servers (backend on :8080, frontend on :5173):
VITE_API_URL=http://localhost:8080/api

# For production (when frontend and backend are served from the same domain):
# VITE_API_URL=/api

# Public site domain used on the marketing landing page for the mockup URLs (e.g.
# "<domain>/apps/inventory") and the "Contact sales" address (sales@<domain>). Baked in at build
# time, so set it before `npm run build`. Defaults to formlogic.com.
# VITE_PUBLIC_DOMAIN=formlogic.com
