# Production build defaults (loaded by `npm run build`, which runs in production mode).
#
# Same-domain deployment: the SPA calls the API at /api on its OWN origin, so you can host the UI
# and the backend under one domain with no CORS setup. This is the recommended default.
#
# Hosting the API on a SEPARATE domain instead? Override this — create ui/.env.production.local
# (git-ignored) with, e.g.:  VITE_API_URL=https://api.example.com/api
VITE_API_URL=/api

VITE_APP_ENV=production
