{
  "schemaVersion": 1,
  "id": "hello-node",
  "name": "Hello Node plugin",
  "version": "0.1.0",
  "publisher": "FormLogic",
  "description": "Minimal Node example plugin: init/health/shutdown, one connector command (echo.ping), and a periodic hello_node.tick event in dev mode.",
  "pluginApiVersion": 1,
  "entry": {
    "kind": "process",
    "command": "node",
    "args": ["index.mjs"]
  },
  "capabilities": ["connector.hello-node.echo.*"],
  "connectors": [
    {
      "id": "hello-node",
      "name": "Hello Node",
      "commands": ["echo.ping"]
    }
  ],
  "events": ["hello_node.tick"]
}
