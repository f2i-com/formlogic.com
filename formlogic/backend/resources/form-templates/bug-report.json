      "label": "Screenshots",
      "description": "Upload screenshots if applicable",
      "required": false,
      "properties": {
        "acceptedFileTypes": [
          ".png",
          ".jpg",
          ".jpeg",
          ".gif"
        ],
        "maxFileSize": 10485760,
        "allowMultiple": true
