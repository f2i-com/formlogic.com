          },
          {
            "id": "a2923f99-076e-4efa-9827-204c064d7e96",
            "label": "Medium - Feature Impaired",
            "value": "medium_-_feature_impaired"
          },
          {
            "id": "23076fd6-3906-4862-8b8b-78028e7927f6",
            "label": "Low - Minor Issue",
            "value": "low_-_minor_issue"
          }
        ]
      }
