      "customLogic": {
        "version": 1,
        "runtime": "quickjs",
        "strictPermissions": true,
        "permissions": [
          "ui.setValues",
          "ui.toast",
          "connector.vehicle.status.read"
        ],
        "scripts": [
          {
            "id": "prestart-request-vehicle",
            "hook": "onScreenEnter",
            "runtime": "quickjs",
            "description": "When a form opens, ask the vehicle connector for current status.",
            "source": "function run(ctx) {\n  if (!ctx.meta || ctx.meta.nativeAvailable === false) {\n    // Browser/mock still services this request; no toast needed.\n  }\n  return {\n    effects: [\n      { type: 'connector.request', connectorId: 'vehicle', command: 'status.read' }\n    ]\n  };\n}"
          },
          {
            "id": "prestart-map-vehicle",
            "hook": "onConnectorEvent",
            "runtime": "quickjs",
            "description": "Map vehicle telemetry into the pre-start fields.",
            "source": "function run(ctx) {\n  var v = ctx.event && ctx.event.vehicleStatus;\n  if (!v) {\n    return { ui: { toast: { level: 'warning', message: 'No vehicle data received.' } } };\n  }\n  return {\n    ui: {\n      setValues: {\n        vehicle_id: v.vehicleId,\n        fleet_number: v.fleetNumber,\n        operator_id: v.operatorId,\n        engine_hours: v.engineHours,\n        fuel_percent: v.fuelPercent,\n        active_fault_codes: (v.faultCodes || []).join(', ')\n      },\n      toast: { level: 'success', message: 'Vehicle ' + (v.fleetNumber || '') + ' loaded' }\n    }\n  };\n}"
          },
          {
            "id": "prestart-before-submit",
            "hook": "onBeforeSubmit",
            "runtime": "quickjs",
            "description": "Block a pre-start on critically low fuel; warn on active faults.",
            "source": "function run(ctx) {\n  var fuel = Number(ctx.answers.fuel_percent || 0);\n  var faults = String(ctx.answers.active_fault_codes || '');\n  if (fuel > 0 && fuel < 15) {\n    return { reject: true, message: 'Fuel is too low (' + fuel + '%) to start this shift.' };\n  }\n  if (faults.trim()) {\n    return { warnings: ['Active fault codes detected (' + faults + '). Supervisor review recommended.'] };\n  }\n  return { ok: true };\n}"
          }
        ]
      }
    }
  ]
