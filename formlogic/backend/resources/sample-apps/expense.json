{
  "formatVersion": 1,
  "packMeta": {
    "name": "Expense Manager",
    "description": "A complete expense submission and approval app with a live spend dashboard, status tracking and per-category budgets.",
    "version": "1.0.0",
    "tags": [
      "demo",
      "expenses",
      "approvals",
      "finance"
    ]
  },
  "forms": [
    {
      "packFormId": "expense",
      "title": "Expense",
      "description": "Submit a business expense for approval.",
      "icon": "Receipt",
      "settings": [],
      "theme": [],
      "logicScript": "function onSubmit(ctx) {\n  // Flag large expenses so approvers can spot them quickly.\n  var amount = Number(ctx.answers.amount);\n  if (amount > 500) {\n    ctx.addTag('high-value');\n  }\n}\n",
      "fields": [
        {
          "id": "description",
          "type": "long_text",
          "label": "Description",
          "required": true,
          "properties": {
            "placeholder": "What was this expense for?"
          }
        },
        {
          "id": "amount",
          "type": "number",
          "label": "Amount (USD)",
          "required": true,
          "properties": {
            "min": 0,
            "prefix": "$"
          }
        },
        {
          "id": "category",
          "type": "dropdown",
          "label": "Category",
          "required": true,
          "properties": {
            "options": [
              {
                "id": "travel",
                "label": "Travel",
                "value": "travel"
              },
              {
                "id": "meals",
                "label": "Meals",
                "value": "meals"
              },
              {
                "id": "software",
                "label": "Software",
                "value": "software"
              },
              {
                "id": "office",
                "label": "Office",
                "value": "office"
              },
              {
                "id": "other",
                "label": "Other",
                "value": "other"
              }
            ]
          }
        },
        {
          "id": "date",
          "type": "date",
          "label": "Date of expense",
          "required": true,
          "properties": []
        },
        {
          "id": "status",
          "type": "dropdown",
          "label": "Status",
          "required": true,
          "properties": {
            "options": [
              {
                "id": "pending",
                "label": "Pending",
                "value": "pending"
              },
              {
                "id": "approved",
                "label": "Approved",
                "value": "approved"
              },
              {
                "id": "rejected",
                "label": "Rejected",
                "value": "rejected"
              }
            ],
            "defaultValue": "pending"
          }
        },
        {
          "id": "submitted_by",
          "type": "short_text",
          "label": "Submitted by",
          "required": true,
          "properties": {
            "placeholder": "Your name"
          }
        }
      ],
      "customScreen": {
        "enabled": true,
        "allowNewResponses": true,
        "kind": "dashboard",
        "dashboard": {
          "version": 1,
          "cols": 12,
          "widgets": [
            {
              "id": "k1",
              "title": "Total claims",
              "layout": {
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:expense",
                "viz": "kpi",
                "measure": {
                  "fn": "count"
                }
              }
            },
            {
              "id": "k2",
              "title": "Total spend",
              "layout": {
                "x": 4,
                "y": 0,
                "w": 4,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:expense",
                "viz": "kpi",
                "measure": {
                  "fn": "sum",
                  "field": "amount"
                }
              }
            },
            {
              "id": "k3",
              "title": "Pending",
              "layout": {
                "x": 8,
                "y": 0,
                "w": 4,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:expense",
                "viz": "kpi",
                "measure": {
                  "fn": "count"
                },
                "filters": [
                  {
                    "field": "status",
                    "op": "eq",
                    "value": "pending"
                  }
                ]
              }
            },
            {
              "id": "c1",
              "title": "Spend by category",
              "layout": {
                "x": 0,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:expense",
                "viz": "bar",
                "groupBy": {
                  "field": "category",
                  "bucket": "none"
                },
                "measure": {
                  "fn": "sum",
                  "field": "amount"
                },
                "seriesSort": "value",
                "sort": "desc",
                "limit": 8
              }
            },
            {
              "id": "c2",
              "title": "Spend over time",
              "layout": {
                "x": 6,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:expense",
                "viz": "area",
                "groupBy": {
                  "field": "date",
                  "bucket": "month"
                },
                "measure": {
                  "fn": "sum",
                  "field": "amount"
                },
                "seriesSort": "label",
                "limit": 12
              }
            },
            {
              "id": "l1",
              "title": "Recent expenses",
              "layout": {
                "x": 0,
                "y": 4,
                "w": 12,
                "h": 3
              },
              "kind": "list",
              "list": {
                "formId": "@pack:expense",
                "titleField": "description",
                "subtitleField": "category",
                "limit": 6
              }
            }
          ]
        }
      }
    },
    {
      "packFormId": "category-budget",
      "title": "Category Budget",
      "description": "Set a monthly spend limit per expense category.",
      "icon": "Wallet",
      "settings": [],
      "theme": [],
      "logicScript": "",
      "fields": [
        {
          "id": "category",
          "type": "dropdown",
          "label": "Category",
          "required": true,
          "properties": {
            "options": [
              {
                "id": "travel",
                "label": "Travel",
                "value": "travel"
              },
              {
                "id": "meals",
                "label": "Meals",
                "value": "meals"
              },
              {
                "id": "software",
                "label": "Software",
                "value": "software"
              },
              {
                "id": "office",
                "label": "Office",
                "value": "office"
