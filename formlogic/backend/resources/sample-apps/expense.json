                "formId": "@pack:category-budget",
                "viz": "kpi",
                "measure": {
                  "fn": "count"
                }
              }
            },
            {
              "id": "k2",
              "title": "Total monthly limit",
              "layout": {
                "x": 4,
                "y": 0,
                "w": 4,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:category-budget",
                "viz": "kpi",
                "measure": {
                  "fn": "sum",
                  "field": "monthly_limit"
                }
              }
            },
            {
              "id": "k3",
              "title": "Avg limit",
              "layout": {
                "x": 8,
                "y": 0,
                "w": 4,
                "h": 1
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:category-budget",
                "viz": "kpi",
                "measure": {
                  "fn": "avg",
                  "field": "monthly_limit"
                }
              }
            },
            {
              "id": "c1",
              "title": "Monthly limit by category",
              "layout": {
                "x": 0,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:category-budget",
                "viz": "bar",
                "groupBy": {
                  "field": "category",
                  "bucket": "none"
                },
                "measure": {
                  "fn": "sum",
                  "field": "monthly_limit"
                },
                "seriesSort": "value",
                "sort": "desc",
                "limit": 8
              }
            },
            {
              "id": "c2",
              "title": "Budget share",
              "layout": {
                "x": 6,
                "y": 1,
                "w": 6,
                "h": 3
              },
              "kind": "report",
              "spec": {
                "formId": "@pack:category-budget",
                "viz": "donut",
                "groupBy": {
                  "field": "category",
                  "bucket": "none"
                },
                "measure": {
                  "fn": "sum",
                  "field": "monthly_limit"
                },
                "limit": 6
              }
            },
            {
              "id": "l1",
              "title": "Recent budgets",
              "layout": {
                "x": 0,
                "y": 4,
                "w": 12,
                "h": 3
              },
              "kind": "list",
              "list": {
                "formId": "@pack:category-budget",
                "titleField": "category",
                "subtitleField": "monthly_limit",
                "limit": 6
              }
            }
          ]
        }
      }
    }
  ],
  "apps": [
