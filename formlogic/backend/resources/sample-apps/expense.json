          }
        }
      ],
      "customScreen": {
        "enabled": true,
        "allowNewResponses": true,
        "kind": "dashboard",
        "dashboard": {
          "version": 1,
          "cols": 12,
          "widgets": [
            {
              "id": "k1",
              "title": "Budgets set",
              "layout": {
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 1
              },
              "kind": "report",
