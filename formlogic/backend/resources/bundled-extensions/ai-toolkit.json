{
  "formatVersion": 2,
  "package": {
    "id": "com.formlogic.ai-toolkit",
    "kind": "extension",
    "version": "1.0.0",
    "publisherId": "com.formlogic",
    "displayName": "AI Toolkit",
    "description": "Chat with a language model, transcribe speech, and synthesize speech — as three flow nodes you point at whichever AI service you have.",
    "keywords": ["ai", "llm", "chat", "speech", "transcription", "text-to-speech", "audio"]
  },
  "contributions": {
    "flowNodes": [
      {
        "schemaVersion": 1,
        "type": "com.formlogic.ai.chat",
        "version": "1.0.0",
        "display": {
          "label": "LLM Chat",
          "description": "Send messages to a language model and get its reply.",
          "category": "AI",
          "iconId": "message-square"
        },
        "configurationSchema": {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "title": "Messages",
              "description": "The conversation so far, oldest first. Each entry is { role, content }.",
              "items": { "type": "object" }
            },
            "model": {
              "type": "string",
              "title": "Model",
              "description": "Leave empty to use the service's default."
            },
            "temperature": {
              "type": "number",
              "title": "Temperature",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": ["messages"]
        },
        "handler": {
          "kind": "service-action",
          "bindingSlot": "languageModel",
          "requiredAction": "chat.complete"
        },
        "sideEffects": "external-write"
      },
      {
        "schemaVersion": 1,
        "type": "com.formlogic.ai.transcribe",
        "version": "1.0.0",
        "display": {
          "label": "Speech to Text",
          "description": "Turn a recording into text.",
          "category": "AI",
          "iconId": "mic"
        },
        "configurationSchema": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "title": "Audio",
              "description": "The recording to transcribe."
            },
            "model": {
              "type": "string",
              "title": "Model",
              "description": "Leave empty to use the service's default."
            },
            "language": {
              "type": "string",
              "title": "Language",
              "description": "An ISO code such as 'en'. Leave empty to detect it."
            },
            "prompt": {
              "type": "string",
              "title": "Vocabulary hint",
              "description": "Names or terms the audio is likely to contain, to help the model spell them."
            }
          },
          "required": ["file"]
        },
        "handler": {
          "kind": "service-action",
          "bindingSlot": "transcriber",
          "requiredAction": "audio.transcribe"
        },
        "sideEffects": "external-write"
      },
      {
        "schemaVersion": 1,
        "type": "com.formlogic.ai.speak",
        "version": "1.0.0",
        "display": {
          "label": "Text to Speech",
          "description": "Turn text into spoken audio. Produces an audio file you can attach or play.",
          "category": "AI",
          "iconId": "volume-2"
        },
        "ports": [
          {
            "id": "audio",
            "direction": "output",
            "kind": "data",
            "schema": { "$ref": "formlogic://schemas/artifact-ref.json", "x-artifactKinds": ["audio"] }
          }
        ],
        "configurationSchema": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "title": "Text",
              "description": "What to say."
            },
            "voice": {
              "type": "string",
              "title": "Voice",
              "description": "Leave empty to use the service's default voice."
            },
            "model": {
              "type": "string",
              "title": "Model",
              "description": "Leave empty to use the service's default."
            },
            "responseFormat": {
              "type": "string",
              "title": "Format",
              "enum": ["mp3", "opus", "aac", "flac", "wav", "pcm"],
              "default": "mp3"
            },
            "speed": {
              "type": "number",
              "title": "Speed",
              "minimum": 0.25,
              "maximum": 4
            }
          },
          "required": ["input"]
        },
        "handler": {
          "kind": "service-action",
          "bindingSlot": "speechSynthesizer",
          "requiredAction": "audio.speech"
        },
        "sideEffects": "external-write"
      }
    ]
  },
  "requirements": {
    "services": [
      {
        "slot": "languageModel",
        "required": false,
        "requiredActions": ["chat.complete"]
      },
      {
        "slot": "transcriber",
        "required": false,
        "requiredActions": ["audio.transcribe"]
      },
      {
        "slot": "speechSynthesizer",
        "required": false,
        "requiredActions": ["audio.speech"]
      }
    ]
  }
}
