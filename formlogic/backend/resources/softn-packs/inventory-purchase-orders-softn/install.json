{
    "formatVersion": 1,
    "packMeta": {
        "id": "inventory-purchase-orders-softn",
        "name": "Inventory & POs (SoftN + Forms)",
        "description": "Turnkey warehouse stock control and purchasing hub: SKU bin locations, low-stock reorder alerts with 1-click Draft PO, multi-line purchase order builder, atomic goods receiving, printable POs, suppliers, and stock audit ledger. Includes the full-stack SoftN application plus 5 schema-matched FormLogic forms & management charts sharing the same live SQLite database.",
        "version": "1.0.0",
        "author": "FormLogic",
        "tags": [
            "inventory",
            "purchasing",
            "stock",
            "suppliers",
            "warehouse",
            "softn",
            "sqlite",
            "shared-database"
        ]
    },
