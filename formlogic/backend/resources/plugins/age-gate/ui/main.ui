<logic>
// The age gate's page. The site tells it which app the person came from, the age that app asks,
// and whether the site's camera check is there for it (pluginContext). The waterfall: the person's
// own word where the app accepts it, which goes to this plugin's backend; a face check where the app
// asks for more, which the site's own page runs with the camera (pluginCamera) and this plugin's
// backend decides. This page never sees the camera or a picture. Then the site takes the person back.
var age = 0;
var ready = false;
var canDeclare = false;
var canFace = false;
var none = false;
var heading = 'Confirm your age';
var lead = 'Loading...';
var declareLabel = 'Loading...';
var message = '';
function _init() {
  softn.backend.call('pluginContext', {}, function(reply) {
    var context = reply && reply.result ? reply.result : null;
    if (!context || !context.requirement || !context.app) {
      lead = 'This page was opened without an app to confirm your age for.';
      return;
    }
    age = context.requirement.min;
    canDeclare = context.requirement.strength == 'declared';
    canFace = context.camera === true;
    none = !canDeclare && !canFace;
    lead = context.app.name + ' is for people aged ' + age + ' and over.';
    if (!canDeclare && canFace) lead = lead + ' It asks for a quick check with your camera.';
    if (none) lead = lead + ' It asks for an age check this site does not offer yet. Ask the app\'s owner.';
    declareLabel = 'I am ' + age + ' or older';
    ready = true;
  });
}
function confirmAge() {
  if (!ready || !canDeclare) return;
  ready = false;
  message = 'Saving...';
  softn.net.fetch('https://age-gate.plugin/api/pass', {method:'POST',body:{minimumAge:age,confirmed:true}}, function(response) {
    if (!response.ok) {
      ready = true;
      message = 'Your age could not be recorded. Try again.';
      return;
    }
    message = 'Thank you. Taking you back...';
    softn.backend.call('pluginDone', {}, function() {});
  });
}
function faceCheck() {
  if (!ready || !canFace) return;
  message = '';
  softn.backend.call('pluginCamera', {}, function(reply) {
    if (reply && reply.error) message = reply.error;
  });
}
</logic>
<Stack padding="lg" gap="md">
  <Heading level={2}>{heading}</Heading>
  <Text size="lg">{lead}</Text>
  #if (canDeclare)
    <Button @click={confirmAge}>{declareLabel}</Button>
    <Text size="sm" variant="muted" lineHeight="relaxed">This is your own word, not a check of your age. It is kept with your account on this site and opens other apps here that ask the same, until it expires or you withdraw it in Settings. Nothing else about you is kept.</Text>
  #end
  #if (canFace)
    <Button variant={canDeclare ? 'secondary' : 'primary'} @click={faceCheck}>Check with your camera</Button>
    <Text size="sm" variant="muted" lineHeight="relaxed">This site's own page takes a few pictures as you turn your head. An AI on the site administrator's computer checks them, and they are deleted. Only the result is kept.</Text>
  #end
  <Text size="sm">{message}</Text>
</Stack>
