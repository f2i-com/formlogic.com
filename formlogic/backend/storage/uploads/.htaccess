# Uploads are served exclusively through the authenticated FileController API, never directly over HTTP.
Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

# Defense in depth: disable script execution even if access rules are misconfigured.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
