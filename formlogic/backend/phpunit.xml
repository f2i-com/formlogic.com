<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- The suite runs whole-database dumps, backup archives and crypto fixtures, and PHPUnit
             itself duplicates asserted values into its event stream. At the 128M CLI default the
             full run peaked at exactly 128M and began dying with an exporter fatal that looked
             nothing like an out-of-memory error. Headroom is declared here so growing the suite
             does not silently reintroduce that. (Individual tests should still avoid handing
             multi-megabyte values to assertions — see ScheduledBackupTest.) -->
        <ini name="memory_limit" value="512M"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
