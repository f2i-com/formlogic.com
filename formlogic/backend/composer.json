{
    "name": "formlogic/api",
    "description": "FormLogic Form Builder API",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "monolog/monolog": "^3.5",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "respect/validation": "^2.3",
        "ext-sodium": "*",
        "seld/jsonlint": "^1.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "FormLogic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FormLogic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    }
}
