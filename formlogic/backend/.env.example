# =============================================================================
# FormLogic Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# DO NOT commit .env to version control.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Environment: "production" or "development".
# ⚠️ "development" relaxes REAL security behaviour (non-Secure auth cookies,
# verbose errors, relaxed destination validation) — never deploy it to a
# public host; the deep health check fails loudly if you do. The install
# wizard writes "production" unless you explicitly pick a development install.
APP_ENV=development

# Show detailed error messages (set to "true" only in development)
APP_DEBUG=true

# -----------------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=formlogic
DB_USERNAME=formlogic

# Set your database user password (REQUIRED in production)
DB_PASSWORD=

# -----------------------------------------------------------------------------
# SQLite Storage
# -----------------------------------------------------------------------------
# Relative path from backend/ for per-form SQLite databases
SQLITE_STORAGE_PATH=storage/forms

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a secure secret (minimum 32 characters). REQUIRED in production.
#   openssl rand -base64 32
# The install script generates this automatically.
JWT_SECRET=

# Token lifetime in seconds (default: 86400 = 24 hours)
JWT_EXPIRY=86400

# JWT issuer and audience claims
JWT_ISSUER=formlogic
JWT_AUDIENCE=formlogic-api

# -----------------------------------------------------------------------------
# Cookie
# -----------------------------------------------------------------------------
# Cookie domain (empty = current domain only)
# For production with a specific domain, e.g.: .example.com
COOKIE_DOMAIN=

# Secure flag on auth cookies (HTTPS-only). Deployment policy, independent of
# APP_ENV: set true for an HTTPS dev vhost, false ONLY for a deliberate
# plain-HTTP intranet deployment. Unset = Secure everywhere except development.
# COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Primary allowed origin for CORS headers
CORS_ORIGIN=http://localhost:5173

# Additional allowed origins (comma-separated, optional)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Maximum login attempts before lockout
LOGIN_MAX_ATTEMPTS=5

# Lockout duration in minutes
LOGIN_DECAY_MINUTES=15

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# Maximum upload file size in bytes (default: 10MB)
UPLOAD_MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# Trusted Proxies (optional)
# -----------------------------------------------------------------------------
# Comma-separated list of trusted proxy IPs or CIDR ranges
# Required if behind a reverse proxy to get accurate client IPs
# Example: TRUSTED_PROXIES=10.0.0.0/8,172.16.0.1
# TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# AI Services (optional)
# -----------------------------------------------------------------------------
# AI form/script generation uses any OpenAI-compatible API. Point AI_BASE_URL at OpenAI, Azure
# OpenAI, or a local/self-hosted server that speaks the OpenAI /v1 spec — LM Studio, Ollama, vLLM,
# etc. AI_API_KEY is OPTIONAL: leave it blank for a keyless local server; set it only if your
# provider requires one. AI features are enabled when EITHER a key is set OR AI_BASE_URL points at
# a non-OpenAI (custom/local) endpoint.
#
# Local server example (LM Studio / Ollama / self-hosted, no key needed):
#   AI_BASE_URL=http://localhost:1234/v1
#   AI_MODEL=your-local-model-id
#   AI_VISION_MODEL=your-local-model-id   # omit to reuse AI_MODEL (for image → form extraction)
#
# OpenAI cloud example:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o
#
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=gpt-4o
# AI_VISION_MODEL=gpt-4o
#
# Turn the in-app (built-in) AI off entirely with AI_ENABLED=false — the "Generate with AI" features
# are hidden and the AI endpoints refuse. Useful when steering users to bring their own (frontier) model
# via the MCP server instead. Defaults to true.
# AI_ENABLED=true
# (Legacy OPENAI_* names are still honored as fallbacks.)
#
# In production an API KEY is never sent over plaintext http:// (the key is disabled). A KEYLESS
# local server over http is fine. To send a key to a loopback model over http, opt in explicitly:
# ALLOW_INSECURE_LOCAL_AI=1

# -----------------------------------------------------------------------------
# Email (transactional: password resets, invitations, response notifications)
# -----------------------------------------------------------------------------
# Set MAIL_FROM_ADDRESS to enable outbound email. With SMTP_HOST set, mail is
# sent via SMTP (requires `composer require symfony/mailer`); otherwise the
# server falls back to PHP mail(). If unset, email features degrade gracefully
# (e.g. invitations still produce a copyable link) — nothing breaks.
# MAIL_FROM_ADDRESS=noreply@yourdomain.com
# MAIL_FROM_NAME=FormLogic
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=tls
# APP_URL=https://app.yourdomain.com   # Public base URL of the React FRONTEND (NOT the API host). Builds reset/invite links in emails; else derived from the allowlisted request Origin. Pointing it at the API host makes those links 404.

# Support / contact address shown to users when email is NOT configured (e.g. a fresh install with no
# SMTP). The password-reset page tells people to email this address to reset their password or verify
# their account by hand, until you set up MAIL_FROM_ADDRESS/SMTP above. Defaults to hello@formlogic.com.
# SUPPORT_EMAIL=hello@formlogic.com

# -----------------------------------------------------------------------------
# Audit Trail
# -----------------------------------------------------------------------------
# HMAC key for audit log integrity verification (REQUIRED in production)
# The install script generates this automatically.
# AUDIT_HMAC_KEY=

# -----------------------------------------------------------------------------
# Billing (PayPal — pay-as-you-go cloud months, optional)
# -----------------------------------------------------------------------------
# Leave blank to disable cloud billing entirely (the /billing page degrades to
# "not configured"). Create REST API app credentials at developer.paypal.com.
# PAYPAL_ENV: 'sandbox' (default) for testing, 'live' for real charges.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# Webhook id (from the PayPal app's webhook config) — enables async settlement of eCheck /
# review-held payments via POST /api/billing/webhook/paypal. Without it, such payments are
# credited when the buyer retries instead.
# PAYPAL_WEBHOOK_ID=
# Price per cloud month, in cents (default 500 = $5.00). One-time, no subscription.
# CLOUD_PRICE_CENTS=500

# -----------------------------------------------------------------------------
# Cloud plan enforcement (hosted SaaS only)
# -----------------------------------------------------------------------------
# Leave false for self-hosting (no limits). Set true ONLY for a hosted multi-tenant
# deployment to enforce per-account plan limits + cloud-expiry write-gating. When true in
# production, PayPal billing MUST be configured (otherwise users hit limits with no way to
# pay to lift them) — the app fails to boot otherwise.
# CLOUD_PLAN_ENFORCED=false
# Personal-plan limits (ignored for enterprise-plan users and when enforcement is off):
# CLOUD_MAX_FORMS=100
# CLOUD_MAX_STORAGE_BYTES=1073741824   # 1 GB

# -----------------------------------------------------------------------------
# Public beta mode
# -----------------------------------------------------------------------------
# Free signup for a limited window with the payment gateway turned OFF — so people can try FormLogic
# (and you can gather feedback + improve it) without anyone paying yet. When BETA_MODE=true:
#   - new accounts get BETA_FREE_DAYS of Cloud on signup (default 90 = ~3 months),
#   - plan limits are NEVER enforced (nobody is locked out — it overrides CLOUD_PLAN_ENFORCED),
#   - the PayPal top-up/checkout is disabled (billing endpoints return a "free during beta" 403),
#   - the SPA shows a "free public beta — no card required" note on signup + billing.
# When you're ready to leave beta, set BETA_MODE=false (and, for hosted SaaS, configure PayPal +
# CLOUD_PLAN_ENFORCED=true). Existing users keep whatever cloud_until they were granted.
# BETA_MODE=false
# BETA_FREE_DAYS=90

# ── Admin panel ────────────────────────────────────────────────────────────────
# Platform administrators (comma-separated emails). Accounts matching this list can
# open the /admin panel even before the users.is_admin flag is set — this is how the
# FIRST admin bootstraps in (they can then grant the durable flag from the panel).
# ADMIN_EMAILS=you@example.com

# In-place upgrades: the folder holding the built UI's index.html. Only needed when
# the panel's Upgrade tab reports the layout wasn't recognized (the deployed zip
# layout — index.html beside an api/ folder — is detected automatically).
# FORMLOGIC_WEB_ROOT=/var/www/formlogic
