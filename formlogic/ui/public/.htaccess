# ============================================================================
# FormLogic — single-domain Apache configuration (ships inside the built SPA).
#
# Deploy everything under ONE web root (DocumentRoot):
#
#   <web-root>/
#     index.html, assets/, sw.js, ...   <- the built UI (copy the contents of ui/dist/ here)
#     .htaccess                          <- this file
#     api/                               <- the PHP backend (copy formlogic/backend/ here)
#                                            front controller: api/public/index.php
#
# Requests to /api/* are handled by the backend; everything else is the SPA.
# The API funnel plus the deny rules below keep .env, config, source, storage,
# and the SQLite databases from ever being served directly over HTTP.
#
# (Hosting the API on a separate domain instead? You don't need the api/ folder
#  or the /api rewrite below — just build with VITE_API_URL pointing at it.)
# ============================================================================

# No directory listings anywhere — even if mod_rewrite is off, this stops Apache
# from autoindexing (and thereby enumerating backend source / per-form DB names).
Options -Indexes

<IfModule mod_headers.c>
  # Security headers for the static SPA document (the API sets its own via
  # SecurityHeadersMiddleware; this covers the React document served by Apache).
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # geolocation/camera stay SELF-only: the form runtime has a Location (GPS)
  # field and a Camera field; () would deny them even to our own pages.
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(self), payment=()"
  # Deny framing of the app shell (clickjacking / UI-redress). No script-src/style-src
  # so the SPA + zipp WASM worker are unaffected — only framing is restricted.
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  # The public form runtime (/form/...) is intentionally embeddable. SetEnvIf matches
  # the original request path before the SPA rewrite to /index.html.
  SetEnvIf Request_URI "^/form/" IS_FORM_RUNTIME
  Header always unset X-Frame-Options env=IS_FORM_RUNTIME
  Header always set Content-Security-Policy "frame-ancestors *; base-uri 'self'; object-src 'none'" env=IS_FORM_RUNTIME
  # Internal SPA rewrites prefix request environment variables with REDIRECT_.
  Header always unset X-Frame-Options env=REDIRECT_IS_FORM_RUNTIME
  Header always set Content-Security-Policy "frame-ancestors *; base-uri 'self'; object-src 'none'" env=REDIRECT_IS_FORM_RUNTIME
  # The custom-screen host is framed by a form, which a customer's page may be framing in turn, and
  # frame-ancestors looks at every ancestor, so this can't be 'self': custom screens would be blank
  # in every embed. The document sandboxes itself instead, so nothing that frames it gets this
  # origin, and its boot takes a screen only from a parent of this origin (check-security-invariants).
  SetEnvIf Request_URI "^/screen-host\.html$" IS_SCREEN_HOST
  Header always unset X-Frame-Options env=IS_SCREEN_HOST
  Header always set Content-Security-Policy "sandbox allow-scripts; frame-ancestors *; base-uri 'self'; object-src 'none'" env=IS_SCREEN_HOST
  # FormLogic embeds its hosted apps and authoring tools from these entry points.
  # Keep the dashboard protected; only these documents accept same-origin frames.
  # host.html is the hosted runtime's SECOND entry document: it serves the host-js
  # engine, whose shell policy carries 'unsafe-eval'. It must therefore be held to
  # exactly the same framing rule as index.html — the document with the weaker
  # script policy must never also be the one anybody may frame.
  SetEnvIf Request_URI "^/(hosted-runtime/(index\.html|host\.html)?|app-editors/(builder|studio)/(index\.html)?)$" IS_APP_FRAME
  Header always set X-Frame-Options "SAMEORIGIN" env=IS_APP_FRAME
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" env=IS_APP_FRAME
  # The runtime documents run other people's code, so the response itself sandboxes them: they
  # stay opaque however they are reached, not only inside FormLogic's own frame. Framed by some
  # other page on a server missing the rules above, they would otherwise run at this origin.
  # After the policy above, which this replaces. The editors are same-origin and stay out of it.
  SetEnvIf Request_URI "^/hosted-runtime/(index\.html|host\.html)?$" IS_APP_RUNTIME
  Header always set Content-Security-Policy "sandbox allow-scripts; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" env=IS_APP_RUNTIME
</IfModule>

# ---- Never serve secrets or server files over HTTP -------------------------
# .env and .env.* (the requirement) and .ht* control files, plus (below) SQLite
# databases, logs, and lock files. These extension/name blocks are rewrite-INDEPENDENT.
<FilesMatch "^\.(env|ht)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "\.(env|sqlite|sqlite3|db|log|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Belt-and-suspenders: block any request that targets a .env file, anywhere in the tree.
  RewriteRule (^|/)\.env(\.|$) - [F,L]

  # API: send every /api/* request to the backend front controller. Because the
  # whole backend lives under ./api, this funnel is ALSO what keeps api/.env,
  # api/config, api/src, api/storage and api/vendor from being fetched directly —
  # the Slim router simply 404s anything that isn't a real API route.
  # Only use the bundled API rewrite when its front controller exists. This
  # prevents a split-domain deployment from looping on a missing ./api path.
  RewriteCond %{DOCUMENT_ROOT}/api/public/index.php -f
  RewriteRule ^api/ api/public/index.php [NC,QSA,L]

  # Never hand a missing same-origin API to the SPA fallback: callers need a
  # real HTTP failure, not index.html (and certainly not recursive rewrites).
  RewriteCond %{DOCUMENT_ROOT}/api/public/index.php !-f
  RewriteRule ^api/ - [NC,R=404,L]

  # Files nobody meant to publish: a dot folder or file (.git/config, .DS_Store) and a backup or a
  # dump left beside the site (backup.sql, site.zip, index.php.bak). The FilesMatch blocks above see
  # a file's own name only, so /.git/config and /backup.sql were plain downloads. /api/ has gone to
  # the backend by now, so its routes end in what they like; .well-known is the certificate
  # challenge's and the backend's.
  RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [R=404,L]
  RewriteRule \.(?:bak|old|orig|save|swp|sql(?:\.gz)?|sqlite3?(?:-wal|-shm)?|db|tar|tar\.gz|tgz|zip|7z|rar)$ - [R=404,L,NC]

  # Custom-domain launch endpoints served by the backend at the domain ROOT. Map three top-level
  # paths to the API front controller so the backend can answer them per-Host (signed client
  # manifest, same-origin PWA manifest, dynamic Android App Links). Gated on the bundled backend
  # existing: in a SPLIT deploy (API on another domain, no ./api here) the condition fails and these
  # rules are skipped, so the static .well-known/assetlinks.json below still serves as the default.
  # Placed BEFORE the SPA fallback (and before the !-f rule) so the dynamic assetlinks route wins
  # over the shipped static file.
  RewriteCond %{DOCUMENT_ROOT}/api/public/index.php -f
  RewriteRule ^\.well-known/(formlogic-app|assetlinks)\.json$ api/public/index.php [QSA,L]
  RewriteCond %{DOCUMENT_ROOT}/api/public/index.php -f
  RewriteRule ^manifest\.json$ api/public/index.php [QSA,L]

  # OAuth discovery for the MCP connector flow (Claude / ChatGPT custom connectors). The backend serves
  # these at the domain ROOT: the RFC 9728 protected-resource metadata (both the root form and the
  # /api/mcp path-suffix form — forward the whole subtree) and the RFC 8414 authorization-server
  # metadata. Same gating as above: only when the bundled backend exists; in a SPLIT deploy the
  # condition fails and discovery happens on the API domain instead. (/oauth/authorize needs no rule —
  # the consent page is an SPA route, so the fallback below already serves it.)
  RewriteCond %{DOCUMENT_ROOT}/api/public/index.php -f
  RewriteRule ^\.well-known/(oauth-protected-resource(/.*)?|oauth-authorization-server)$ api/public/index.php [QSA,L]

  # Native Aokie Companion deployment discovery. Keep both the extensionless
  # well-known URI and its explicit JSON alias out of the SPA fallback so a
  # native client always receives the signed PHP discovery document.
  RewriteCond %{DOCUMENT_ROOT}/api/public/index.php -f
  RewriteRule ^\.well-known/aokie-companion(\.json)?$ api/public/index.php [QSA,L]

  # SPA: serve real files (assets, index.html, service worker) as-is...
  RewriteRule ^index\.html$ - [L]
  # A build file that isn't here is a page from an older release asking for it. Answered with the
  # app shell it is an HTML "script", and a CDN keeps that under the script's name. The hosted
  # runtime and the editors have assets/ folders of their own, and these rules reach them: the
  # .htaccess in hosted-runtime/ sets headers only, and a folder with no rewrite directive of its
  # own keeps this file's. Named from the root, so /app/assets/ stays the route of an app with
  # that slug. A status outside 3xx sends no Location, so this redirects nothing.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(assets|hosted-runtime/assets|app-editors/[^/]+/assets)/ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # ...and hand every other path to the app shell for client-side routing.
  RewriteRule . /index.html [L]
</IfModule>

# ============================================================================
# What a browser has to ask for every time.
#
# sw.js is how a browser learns that a release changed anything, and it keeps
# running the page it has stored until this file differs. A file with no
# Cache-Control is the CDN's to keep: Cloudflare holds .js for hours, so after an
# update every returning visitor stayed on the old release's page, against the
# new server. On v0.1.19 that page's two-factor setup sent no password, which
# locked an administrator out of the admin panel. Every other script is named
# after its content, so only these need saying.
# ============================================================================
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ============================================================================
# Compression.
#
# The expression sandbox (assets/zipp_wasm_bg-*.wasm) is 7.34 MB uncompressed and
# ~1.8 MB with Brotli (ZIPP v0.0.32) — it is mostly a table-driven interpreter, which is exactly
# what a compressor eats. Served without Content-Encoding it is a 7.34 MB download
# for anyone who opens a form with a calculated field, a conditional rule or a
# validation rule.
#
# EVERY block is guarded, and the guard that matters most is the OUTER one:
# `AddOutputFilterByType` is provided by mod_filter, NOT by mod_deflate or
# mod_brotli. Guarding only on the compressor would let this file parse on a
# server that has deflate but not filter — and an unknown directive in .htaccess
# is a 500 on every request, not a warning. (WAMP ships all three modules
# commented out, so this is a real configuration, not a hypothetical one.)
#
# Brotli is listed first: where both are enabled Apache honours the client's
# Accept-Encoding preference, and every browser that offers `br` prefers it.
#
# Deliberately NOT compressed: images, video, audio, woff2 fonts and archives are
# already compressed. Running them through again costs CPU per request and
# usually makes them slightly larger.
# ============================================================================
<IfModule mod_filter.c>
  <IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS \
      text/html text/plain text/css text/xml text/csv \
      application/javascript application/json application/manifest+json \
      application/wasm application/xml image/svg+xml
  </IfModule>

  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
      text/html text/plain text/css text/xml text/csv \
      application/javascript application/json application/manifest+json \
      application/wasm application/xml image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_setenvif.c>
  # Belt and braces for the already-compressed formats: a proxy or an earlier
  # directive can still route them here, and re-deflating them is pure waste.
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|mp4|webm|mp3|zip|gz|br|woff2?)$ no-gzip dont-vary
</IfModule>

<IfModule mod_mime.c>
  # Apache 2.4 does not map .wasm by default on every build. Without the correct
  # type the browser refuses the streaming instantiation path AND the filters
  # above never match, so the engine ships uncompressed and loads slowly.
  AddType application/wasm .wasm
</IfModule>
