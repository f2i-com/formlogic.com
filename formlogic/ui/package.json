{
  "name": "formlogic",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "capture:dashboard-preview": "node scripts/capture-dashboard-preview.mjs",
    "sync:prelude": "node scripts/sync-prelude.mjs",
    "build:script-profile": "node scripts/build-script-profile.mjs",
    "prebuild": "node scripts/sync-prelude.mjs && node scripts/build-script-profile.mjs && node scripts/check-hosted-runtime.mjs && node scripts/check-app-editors.mjs && node scripts/clean-dist.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "node scripts/check-hosted-runtime.mjs",
    "test": "vitest run",
    "pretypecheck:test": "node scripts/check-hosted-runtime.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:zipp-sharing": "node scripts/check-zipp-sharing.mjs",
    "test:tooling": "node scripts/check-tooling.mjs",
    "test:hosted-runtime": "node --test scripts/hosted-runtime-artifact.test.mjs scripts/check-app-editors.test.mjs",
    "test:script-profile": "node scripts/build-script-profile.mjs --check && node --test scripts/build-script-profile.test.mjs",
    "build:hosted-runtime": "node scripts/build-hosted-runtime.mjs",
    "build:app-editors": "node scripts/build-app-editors.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "framer-motion": "^13.4.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.56.0",
    "preact": "^10.29.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.7.0",
    "tweetnacl": "^1.0.3",
    "uuid": "^14.0.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.15"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
