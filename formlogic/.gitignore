# Dependencies
node_modules/
vendor/
# ...except the vendored expression engine. `vendor/` above is a broad net aimed at
# Composer (see /backend/vendor/ below), and it silently swallowed ui/vendor/ —
# which holds the zipp wasm build the browser sandbox needs. Without this the tree
# clones without an engine and every form with logic fails at runtime.
!ui/vendor/

# PHPUnit cache
.phpunit.cache/
backend/.phpunit.cache/

# Build outputs
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# PHP
/backend/vendor/
/backend/storage/forms/*.db
/backend/storage/forms/*.sqlite
# SQLite runs these databases in WAL mode, so each one carries a -wal and a
# -shm sidecar. Ignoring only the .sqlite left 468 untracked runtime files in
# `git status`, which both buries real changes and invites committing live
# response data.
/backend/storage/forms/*.sqlite-wal
/backend/storage/forms/*.sqlite-shm
/backend/storage/forms/*.db-wal
/backend/storage/forms/*.db-shm
# Ad-hoc safety copies taken before a schema or data change. Same live response
# data as the originals, so they are ignored for the same reason.
/backend/storage/forms/*.bak-*
/backend/storage/uploads/
/backend/storage/packs/
/backend/storage/pack-screenshots/
# Admin-panel runtime state: the maintenance flag, uploaded/staged upgrade
# packages, and pre-upgrade backups (DB exports + code snapshots).
/backend/storage/maintenance.json
/backend/storage/upgrades/
/backend/storage/backups/
# Account-backup staging (export zips are built + streamed from here)
/backend/storage/tmp/
# Recycle-bin snapshots (restorable delete captures, purged after 30 days)
/backend/storage/trash/
# Signing keys this install mints for itself. Private key material: it is
# per-install, it is not shared, and a `git add -A` would otherwise stage it —
# every other runtime path under storage/ is ignored, and this one was not.
/backend/storage/keys/
/backend/logs/*.log

# OS files
Thumbs.db
.DS_Store

# Testing
coverage/
.nyc_output/
