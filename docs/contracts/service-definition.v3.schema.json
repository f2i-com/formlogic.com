{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formlogic.com/contracts/service-definition.v3.schema.json",
  "title": "FormLogic ServiceDefinition v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "publisher",
    "name",
    "description",
    "kind",
    "category",
    "tags",
    "capabilities",
    "auth",
    "settingsSchema",
    "permissions",
    "actions"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "#/$defs/namespacedId" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "minDesktopVersion": { "type": "string", "maxLength": 64 },
    "maxTestedDesktopVersion": { "type": "string", "maxLength": 64 },
    "publisher": { "$ref": "#/$defs/publisher" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "icon": { "type": "string", "maxLength": 256 },
    "kind": {
      "enum": [
        "managed-process",
        "remote-provider",
        "delegated-agent",
        "plugin-connector",
        "hybrid"
      ]
    },
    "category": { "$ref": "#/$defs/category" },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tag" }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/namespacedId" }
    },
    "auth": { "$ref": "#/$defs/auth" },
    "settingsSchema": {
      "type": "object",
      "description": "JSON Schema Draft 2020-12 for non-secret connection settings."
    },
    "ui": {
      "type": "object",
      "description": "Presentation hints. Unknown presentation-only fields may round-trip.",
      "additionalProperties": true
    },
    "permissions": { "$ref": "#/$defs/permissions" },
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
      "maxLength": 48
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "verified"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "verified": { "type": "boolean" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategies"],
      "properties": {
        "strategies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/authStrategy" }
        }
      }
    },
    "authStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "kind": {
          "enum": [
            "none",
            "api-key",
            "bearer",
            "basic",
            "oauth2-pkce",
            "oauth-device",
            "delegated-process"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "secretFields": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/namespacedId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "secrets", "dataClasses"],
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "host"],
            "properties": {
              "scheme": { "enum": ["https", "http", "stdio", "plugin"] },
              "host": { "type": "string", "minLength": 1, "maxLength": 253 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        },
        "dataClasses": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "category",
        "tags",
        "capability",
        "sideEffects",
        "idempotency",
        "timeoutMs",
        "inputSchema",
        "outputSchema",
        "transport",
        "requiredGrants",
        "dataClasses"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "category": { "$ref": "#/$defs/category" },
        "tags": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tag" }
        },
        "capability": { "$ref": "#/$defs/namespacedId" },
        "sideEffects": {
          "enum": ["none", "read", "write", "external-communication", "financial", "destructive"]
        },
        "idempotency": { "enum": ["none", "optional", "required"] },
        "streaming": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "cancellable"],
          "properties": {
            "mode": { "enum": ["none", "sse", "jsonl", "events"] },
            "cancellable": { "type": "boolean" }
          }
        },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 900000 },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "transport": { "$ref": "#/$defs/transport" },
        "request": { "$ref": "#/$defs/requestMapping" },
        "response": { "$ref": "#/$defs/responseMapping" },
        "requiredGrants": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        },
        "dataClasses": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "http",
            "openai-compatible",
            "managed-process-http",
            "stdio-jsonrpc",
            "plugin-command"
          ]
        },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "maxLength": 2048 },
        "rpcMethod": { "type": "string", "maxLength": 160 },
        "command": { "type": "string", "maxLength": 160 },
        "authInjection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "secret"],
          "properties": {
            "kind": { "enum": ["bearer", "api-key-header", "basic"] },
            "secret": { "$ref": "#/$defs/namespacedId" },
            "header": { "type": "string", "maxLength": 120 }
          }
        }
      }
    },
    "requestMapping": {
      "type": "object",
      "additionalProperties": false,
      "not": { "required": ["body", "multipart"] },
      "properties": {
        "query": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mappingExpression" } },
        "headers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mappingExpression" } },
        "body": { "$ref": "#/$defs/mappingExpression" },
        "multipart": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
          "additionalProperties": { "$ref": "#/$defs/multipartPartMapping" }
        }
      }
    },
    "multipartPartMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "contentType"],
      "properties": {
        "value": { "$ref": "#/$defs/mappingExpression" },
        "contentType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "filename": { "$ref": "#/$defs/mappingExpression" }
      }
    },
    "responseMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "successStatuses": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "contentTypes": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 160 }
        },
        "output": { "$ref": "#/$defs/mappingExpression" },
        "error": { "$ref": "#/$defs/mappingExpression" }
      }
    },
    "mappingExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$path"],
          "properties": { "$path": { "type": "string", "pattern": "^\\$\\.(input|settings|context|response)(?:\\.|$)" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$literal"],
          "properties": { "$literal": true }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$coalesce"],
          "properties": {
            "$coalesce": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/mappingExpression" }
            }
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "description": "Ordinary mapped object keys cannot shadow reserved $ operators.",
            "pattern": "^(?!\\$).{1,128}$"
          },
          "additionalProperties": { "$ref": "#/$defs/mappingExpression" }
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/mappingExpression" }
        }
      ]
    }
  }
}
