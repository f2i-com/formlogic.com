{
  "schemaVersion": 3,
  "id": "openai-api",
  "version": "1.2.0",
  "minDesktopVersion": "0.1.0",
  "publisher": {
    "id": "formlogic",
    "name": "FormLogic",
    "verified": true
  },
  "name": "OpenAI API — separate API billing",
  "description": "OpenAI inference using the customer's OpenAI Platform account. API usage is billed separately from ChatGPT.",
  "icon": "openai",
  "kind": "remote-provider",
  "category": { "id": "ai.models", "label": "AI & Models" },
  "tags": ["llm", "chat", "streaming", "cloud", "audio", "transcription", "realtime"],
  "capabilities": [
    "llm.chat",
    "llm.chat.stream",
    "models.list",
    "speech.transcribe",
    "audio.chat",
    "voice.realtime"
  ],
  "auth": {
    "strategies": [
      {
        "id": "api-key",
        "kind": "api-key",
        "label": "OpenAI Platform API key",
        "secretFields": [{ "id": "api-key", "label": "API key" }]
      }
    ]
  },
  "settingsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string", "format": "uri", "default": "https://api.openai.com" },
      "model": { "type": "string" },
      "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 120000 }
    },
    "required": ["baseUrl"]
  },
  "ui": {
    "settings": {
      "model": { "widget": "model-picker", "action": "models.list" },
      "baseUrl": { "section": "Advanced", "lockedByDefault": true }
    }
  },
  "permissions": {
    "network": [{ "scheme": "https", "host": "api.openai.com" }],
    "secrets": ["api-key"],
    "dataClasses": ["prompts", "conversation-history", "audio", "transcripts"]
  },
  "actions": [
    {
      "id": "chat.complete",
      "title": "Generate a chat response",
      "description": "Generate one normalized OpenAI-compatible chat response through Desktop-held credentials.",
      "category": { "id": "ai.chat", "label": "AI / Chat" },
      "tags": ["chat", "streaming"],
      "capability": "llm.chat",
      "sideEffects": "none",
      "idempotency": "optional",
      "streaming": { "mode": "sse", "cancellable": true },
      "timeoutMs": 120000,
      "inputSchema": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "model": { "type": "string" },
          "messages": { "type": "array", "items": { "type": "object" } }
        }
      },
      "outputSchema": { "type": "object" },
      "transport": {
        "kind": "openai-compatible",
        "method": "POST",
        "path": "/v1/chat/completions",
        "authInjection": { "kind": "bearer", "secret": "api-key" }
      },
      "request": { "body": { "$path": "$.input" } },
      "response": { "successStatuses": [200], "contentTypes": ["application/json", "text/event-stream"], "output": { "$path": "$.response" } },
      "requiredGrants": ["services.invoke"],
      "dataClasses": ["prompts", "conversation-history"]
    },
    {
      "id": "models.list",
      "title": "List available models",
      "description": "List models exposed to the connected OpenAI Platform account.",
      "category": { "id": "ai.models", "label": "AI / Models" },
      "tags": ["models", "discovery"],
      "capability": "models.list",
      "sideEffects": "read",
      "idempotency": "optional",
      "streaming": { "mode": "none", "cancellable": false },
      "timeoutMs": 30000,
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": { "type": "object" },
      "transport": {
        "kind": "openai-compatible",
        "method": "GET",
        "path": "/v1/models",
        "authInjection": { "kind": "bearer", "secret": "api-key" }
      },
      "response": { "successStatuses": [200], "contentTypes": ["application/json"], "output": { "$path": "$.response" } },
      "requiredGrants": ["services.read"],
      "dataClasses": []
    },
    {
      "id": "audio.transcribe",
      "title": "Transcribe audio",
      "description": "Transcribe an uploaded audio recording with gpt-4o-mini-transcribe or another compatible model through Desktop-held credentials.",
      "category": { "id": "ai.audio", "label": "AI / Audio" },
      "tags": ["audio", "transcription", "speech-to-text"],
      "capability": "speech.transcribe",
      "sideEffects": "external-communication",
      "idempotency": "optional",
      "streaming": { "mode": "none", "cancellable": true },
      "timeoutMs": 120000,
      "inputSchema": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string", "format": "binary" },
          "model": { "type": "string", "default": "gpt-4o-mini-transcribe" },
          "language": { "type": "string" },
          "prompt": { "type": "string" },
          "responseFormat": { "type": "string", "default": "json" },
          "temperature": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["text"],
        "properties": { "text": { "type": "string" } }
      },
      "transport": {
        "kind": "openai-compatible",
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "authInjection": { "kind": "bearer", "secret": "api-key" }
      },
      "request": { "body": { "$path": "$.input" } },
      "response": { "successStatuses": [200], "contentTypes": ["application/json"], "output": { "$path": "$.response" } },
      "requiredGrants": ["services.invoke"],
      "dataClasses": ["audio", "transcripts"]
    },
    {
      "id": "audio.speech",
      "title": "Synthesize speech",
      "description": "Turn text into spoken audio through Desktop-held credentials. The response is audio bytes, so the caller receives an ArtifactRef rather than the audio inline — speech is far too large to travel inside a flow's node payloads or run logs.",
      "category": { "id": "ai.audio", "label": "AI / Audio" },
      "tags": ["audio", "speech", "text-to-speech", "tts"],
      "capability": "speech.synthesize",
      "sideEffects": "external-communication",
      "idempotency": "optional",
      "streaming": { "mode": "none", "cancellable": true },
      "timeoutMs": 120000,
      "inputSchema": {
        "type": "object",
        "required": ["input"],
        "properties": {
          "input": { "type": "string", "description": "The text to speak." },
          "model": { "type": "string", "default": "gpt-4o-mini-tts" },
          "voice": { "type": "string", "default": "alloy" },
          "responseFormat": { "type": "string", "default": "mp3", "description": "Audio container: mp3, opus, aac, flac, wav or pcm." },
          "speed": { "type": "number", "minimum": 0.25, "maximum": 4 }
        }
      },
      "outputSchema": { "$ref": "formlogic://schemas/artifact-ref.json", "x-artifactKinds": ["audio"] },
      "transport": { "kind": "openai-compatible", "method": "POST", "path": "/v1/audio/speech", "authInjection": { "kind": "bearer", "secret": "api-key" } },
      "request": { "body": { "$path": "$.input" } },
      "response": { "successStatuses": [200], "contentTypes": ["audio/mpeg", "audio/opus", "audio/aac", "audio/flac", "audio/wav", "audio/pcm"], "output": { "$path": "$.response" } },
      "requiredGrants": ["services.invoke"],
      "dataClasses": ["audio", "prompts"]
    },
    {
      "id": "audio.chat",
      "title": "Generate an audio response",
      "description": "Send text or audio messages to gpt-audio-1.5 or another compatible audio model and receive a typed text/audio chat response.",
      "category": { "id": "ai.audio", "label": "AI / Audio" },
      "tags": ["audio", "chat", "speech"],
      "capability": "audio.chat",
      "sideEffects": "external-communication",
      "idempotency": "optional",
      "streaming": { "mode": "none", "cancellable": true },
      "timeoutMs": 120000,
      "inputSchema": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "model": { "type": "string", "default": "gpt-audio-1.5" },
          "messages": { "type": "array", "items": { "type": "object" } },
          "modalities": { "type": "array", "items": { "enum": ["text", "audio"] } },
          "audio": { "type": "object" }
        }
      },
      "outputSchema": { "type": "object" },
      "transport": {
        "kind": "openai-compatible",
        "method": "POST",
        "path": "/v1/chat/completions",
        "authInjection": { "kind": "bearer", "secret": "api-key" }
      },
      "request": { "body": { "$path": "$.input" } },
      "response": { "successStatuses": [200], "contentTypes": ["application/json"], "output": { "$path": "$.response" } },
      "requiredGrants": ["services.invoke"],
      "dataClasses": ["prompts", "conversation-history", "audio", "transcripts"]
    },
    {
      "id": "realtime.session.create",
      "title": "Create a Realtime WebRTC session",
      "description": "Exchange a browser WebRTC SDP offer for an answer using gpt-realtime-2.1-mini or another compatible Realtime model without exposing the API key.",
      "category": { "id": "ai.realtime", "label": "AI / Realtime" },
      "tags": ["audio", "realtime", "webrtc"],
      "capability": "voice.realtime",
      "sideEffects": "external-communication",
      "idempotency": "none",
      "streaming": { "mode": "events", "cancellable": true },
      "timeoutMs": 30000,
      "inputSchema": {
        "type": "object",
        "required": ["sdp"],
        "properties": {
          "sdp": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "default": "gpt-realtime-2.1-mini" },
          "voice": { "type": "string" },
          "instructions": { "type": "string" },
          "session": {
            "type": "object",
            "description": "Optional full Realtime session configuration. Desktop forces type=realtime, applies the shortcut fields above, and injects the configured provider model when absent."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["sdp"],
        "properties": { "sdp": { "type": "string" } }
      },
      "transport": {
        "kind": "openai-compatible",
        "method": "POST",
        "path": "/v1/realtime/calls",
        "authInjection": { "kind": "bearer", "secret": "api-key" }
      },
      "request": {
        "multipart": {
          "sdp": {
            "value": { "$path": "$.input.sdp" },
            "contentType": "application/sdp"
          },
          "session": {
            "value": { "$path": "$.context.realtimeSession" },
            "contentType": "application/json"
          }
        }
      },
      "response": {
        "successStatuses": [200, 201],
        "contentTypes": ["application/sdp"],
        "output": { "sdp": { "$path": "$.response" } }
      },
      "requiredGrants": ["services.invoke"],
      "dataClasses": ["prompts", "conversation-history", "audio", "transcripts"]
    },
    {
      "id": "realtime.stream.connect",
      "title": "Connect Aokie Realtime phone audio",
      "description": "Open one Desktop-brokered, provider-authenticated Realtime WebSocket for a consent-bound Aokie call. This action is restricted to the signed Aokie plugin and is never granted to a paired website.",
      "category": { "id": "ai.realtime", "label": "AI / Realtime" },
      "tags": ["audio", "realtime", "websocket", "aokie", "phone"],
      "capability": "voice.realtime",
      "sideEffects": "external-communication",
      "idempotency": "none",
      "streaming": { "mode": "events", "cancellable": true },
      "timeoutMs": 900000,
      "inputSchema": {
        "type": "object",
        "required": ["callId", "generation", "destinationOrigin"],
        "properties": {
          "callId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "generation": { "type": "integer", "minimum": 0 },
          "destinationOrigin": { "type": "string", "format": "uri" },
          "voice": { "type": "string" },
          "instructions": { "type": "string" },
          "greeting": { "type": "string" },
          "turnDetection": { "type": ["string", "object"] },
          "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 4096 }
        }
      },
      "outputSchema": {
        "type": "object",
        "description": "Fenced ready/item/transcript/error controls plus raw PCM16LE mono 24 kHz binary frames."
      },
      "transport": {
        "kind": "openai-compatible",
        "method": "GET",
        "path": "/v1/realtime",
        "authInjection": { "kind": "bearer", "secret": "api-key" }
      },
      "request": { "query": { "model": { "$path": "$.settings.model" } } },
      "requiredGrants": ["aokie.realtime"],
      "dataClasses": ["prompts", "conversation-history", "audio", "transcripts"]
    }
  ]
}
