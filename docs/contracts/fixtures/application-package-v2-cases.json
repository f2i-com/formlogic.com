{
  "description": "Shared validation cases for Application Package v2 + Flow Node Definition v1 (ADR-010). Asserted IDENTICALLY by the TypeScript validator (ui/src/application-package/packageV2.test.ts) and the PHP validator (backend/tests/Unit/ApplicationPackageV2ContractTest.php): a valid case must produce ZERO issues; an invalid case must produce the expected code. Fixture rule: empty {} vs [] containers are avoided where the languages cannot distinguish them after JSON decode.",
  "cases": [
    {
      "name": "valid: node-only extension (no content.pack, no fake launcher app)",
      "kind": "package",
      "valid": true,
      "value": {
        "formatVersion": 2,
        "package": { "id": "com.acme.media-tools", "kind": "extension", "version": "1.4.0", "publisherId": "com.acme", "displayName": "Acme Media Tools" },
        "contributions": {
          "flowNodes": [
            {
              "schemaVersion": 1,
              "type": "com.acme.media.generate-image",
              "version": "1.2.0",
              "display": { "label": "Generate image", "description": "Generate an image using the configured media service", "category": "AI & Media", "iconId": "image-sparkles" },
              "ports": [
                { "id": "prompt", "direction": "input", "kind": "data", "required": true, "schema": { "type": "string", "minLength": 1 } },
                { "id": "image", "direction": "output", "kind": "data", "schema": { "$ref": "formlogic://schemas/artifact-ref.json", "x-artifactKinds": ["image"] } }
              ],
              "configurationSchema": { "type": "object", "properties": { "width": { "type": "integer", "minimum": 64, "maximum": 4096 }, "height": { "type": "integer", "minimum": 64, "maximum": 4096 } }, "additionalProperties": false },
              "uiHints": { "width": { "control": "number", "group": "Output" }, "height": { "control": "number", "group": "Output" } },
              "handler": { "kind": "service-action", "bindingSlot": "imageGenerator", "requiredAction": "generate-image" },
              "availability": ["desktop", "paired-browser"],
              "requiredGrants": [],
              "sideEffects": "external-write",
              "idempotency": "caller-key",
              "deprecation": null
            }
          ]
        },
        "requirements": {
          "services": [
            { "slot": "imageGenerator", "required": true, "requiredActions": ["generate-image"], "constraints": { "artifactKinds": ["image"], "availability": ["desktop", "paired-browser"] } }
          ]
        }
      }
    },
    {
      "name": "valid: full bundle with dependencies, entry-path content, and a signed distribution candidate",
      "kind": "package",
      "valid": true,
      "value": {
        "formatVersion": 2,
        "package": { "id": "com.acme.media-suite", "kind": "bundle", "version": "2.0.0", "publisherId": "com.acme", "displayName": "Acme Media Suite", "description": "Everything media." },
        "dependencies": {
          "packages": [
            { "id": "com.formlogic.artifacts", "version": "^2.1.0", "optional": false, "reason": "Stores generated image and video outputs" }
          ],
          "desktop": { "minimumVersion": "1.18.0", "features": ["service-definitions.v3", "component-install-jobs.v1"] }
        },
        "content": { "pack": "pack.json" },
        "contributions": { "flowNodes": ["flow-nodes/generate-image.json"] },
        "requirements": { "services": [{ "slot": "imageGenerator", "required": true, "requiredActions": ["generate-image"] }] },
        "serviceDistributions": [
          {
            "id": "com.acme.image-runtime",
            "runtimeKind": "managed-service",
            "satisfiesSlots": ["imageGenerator"],
            "optionalCandidate": true,
            "definition": "services/image-runtime.definition.json",
            "artifact": { "artifactId": "artifact_com_acme_image_runtime", "version": "3.2.1", "sha256": "abababababababababababababababababababababababababababababababab" },
            "installPolicy": "prompt",
            "autoStart": "auto"
          }
        ]
      }
    },
