{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://formlogic.dev/pack-schema-v1.json",
  "title": "FormLogic Pack (v1)",
  "description": "A portable bundle of forms, apps, custom screens, scripts, and roles. See docs/PACK_FORMAT.md. Import regenerates all ids and remaps @pack: references; it never carries responses, members, or secrets.",
  "type": "object",
  "required": ["formatVersion", "packMeta", "forms"],
  "additionalProperties": true,
  "properties": {
    "formatVersion": { "const": 1 },
    "packMeta": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/definitions/packForm" }
    },
    "apps": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/definitions/packApp" }
    }
  },
  "definitions": {
    "customScreen": {
      "type": "object",
      "description": "A sandboxed HTML/CSS/TypeScript frontend. Provide `ts` (single file) OR `files` (multi-file project). Compiled/bundled to `js` automatically.",
      "properties": {
        "enabled": { "type": "boolean" },
        "html": { "type": "string" },
        "css": { "type": "string" },
        "ts": { "type": "string" },
        "js": { "type": "string" },
        "entry": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "properties": { "path": { "type": "string" }, "content": { "type": "string" } }
          }
        },
        "publicRecords": { "type": "boolean" },
        "publicRecordFields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" },
        "properties": {
          "type": "object",
          "description": "Type-specific. dropdown/choice: { options: [{id,label,value}] }. linked_record: { targetFormId: '@pack:<packFormId>' }."
        },
        "conditionalLogic": {},
        "validation": {}
      }
    },
    "packForm": {
      "type": "object",
      "required": ["packFormId", "title", "fields"],
      "properties": {
        "packFormId": { "type": "string", "minLength": 1, "description": "Unique local key; @pack: references point at this." },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": ["string", "null"] },
        "icon": { "type": ["string", "null"], "maxLength": 100 },
        "settings": { "type": "object" },
        "theme": { "type": "object" },
        "logicScript": { "type": "string", "description": "QuickJS onSubmit(ctx) script (<= 100KB)." },
        "customScreen": { "$ref": "#/definitions/customScreen" },
        "fields": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/field" } }
      }
    },
    "permission": {
      "type": "object",
      "required": ["permission"],
      "properties": {
        "packFormId": { "type": ["string", "null"], "description": "@pack: form ref, or null for an app-level permission." },
        "permission": { "type": "string" }
      }
    },
    "role": {
      "type": "object",
      "required": ["name", "permissions"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "system": { "type": "boolean", "description": "true = apply to the same-named built-in role (Admin/Member) on import; false = create a custom role. Owner is never exported." },
        "permissions": { "type": "array", "items": { "$ref": "#/definitions/permission" } }
      }
    },
    "packApp": {
      "type": "object",
      "required": ["packAppId", "name"],
      "properties": {
        "packAppId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "logoUrl": { "type": ["string", "null"] },
        "settings": { "type": "object", "description": "landingPage may be a '@pack:<key>' ref; defaultRoleName is re-resolved on import." },
        "theme": { "type": "object" },
        "navConfig": {
          "type": "array",
          "items": { "type": "object", "properties": { "formId": { "type": "string", "description": "'@pack:<key>' or omitted for a non-form nav item." } } }
        },
        "customScreen": { "$ref": "#/definitions/customScreen" },
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["packFormId"],
            "properties": {
              "packFormId": { "type": "string" },
              "displayName": { "type": ["string", "null"] },
              "sortOrder": { "type": "integer" },
              "isVisible": { "type": "boolean" },
              "settings": { "type": "object" }
            }
          }
        },
        "roles": { "type": "array", "items": { "$ref": "#/definitions/role" } }
      }
    }
  }
}
