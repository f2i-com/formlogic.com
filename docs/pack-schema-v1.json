{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://formlogic.dev/pack-schema-v1.json",
  "title": "FormLogic Pack (v1)",
  "description": "A portable bundle of forms, apps, custom screens, scripts, and roles. See docs/PACK_FORMAT.md. Import regenerates all ids and remaps @pack: references; it never carries responses, members, or secrets.",
  "type": "object",
  "required": ["formatVersion", "packMeta", "forms"],
  "additionalProperties": true,
  "properties": {
    "formatVersion": { "const": 1 },
    "packMeta": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/definitions/packForm" }
    },
    "apps": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/definitions/packApp" }
    }
  },
  "definitions": {
    "customScreen": {
      "type": "object",
      "description": "A sandboxed HTML/CSS/TypeScript frontend. Provide `ts` (single file) OR `files` (multi-file project). Compiled/bundled to `js` automatically.",
      "properties": {
        "enabled": { "type": "boolean" },
        "html": { "type": "string" },
        "css": { "type": "string" },
        "ts": { "type": "string" },
        "js": { "type": "string" },
        "entry": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "properties": { "path": { "type": "string" }, "content": { "type": "string" } }
          }
        },
        "publicRecords": { "type": "boolean" },
        "publicRecordFields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" },
        "properties": {
          "type": "object",
          "description": "Type-specific. dropdown/choice: { options: [{id,label,value}] }. linked_record: { targetFormId: '@pack:<packFormId>' }."
        },
        "conditionalLogic": {},
        "validation": {}
      }
    },
    "packForm": {
      "type": "object",
      "required": ["packFormId", "title", "fields"],
      "properties": {
        "packFormId": { "type": "string", "minLength": 1, "description": "Unique local key; @pack: references point at this." },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": ["string", "null"] },
        "icon": { "type": ["string", "null"], "maxLength": 100 },
        "settings": { "type": "object" },
        "theme": { "type": "object" },
        "logicScript": { "type": "string", "description": "QuickJS onSubmit(ctx) script (<= 100KB)." },
        "customScreen": { "$ref": "#/definitions/customScreen" },
        "fields": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/field" } }
      }
    },
    "permission": {
      "type": "object",
      "required": ["permission"],
      "properties": {
        "packFormId": { "type": ["string", "null"], "description": "@pack: form ref, or null for an app-level permission." },
        "permission": { "type": "string" }
      }
    },
    "role": {
      "type": "object",
      "required": ["name", "permissions"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "system": { "type": "boolean", "description": "true = apply to the same-named built-in role (Admin/Member) on import; false = create a custom role. Owner is never exported." },
        "permissions": { "type": "array", "items": { "$ref": "#/definitions/permission" } }
      }
    },
    "packReportSpec": {
      "type": "object",
      "description": "Chart query spec for a kind:'chart' report item. formId and joins[].formId use '@pack:<packFormId>' refs. Joined-form field refs are '@pack:<key>::<fieldId>'; base-form fields are bare ids. '__submitted_at' and '__status' are pseudo-fields available on every form.",
      "required": ["formId", "viz"],
      "properties": {
        "formId": { "type": "string", "description": "'@pack:<packFormId>' — the primary/base form for this query." },
        "viz": { "type": "string", "enum": ["table", "bar", "line", "area", "pie", "donut", "kpi"] },
        "joins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "via": { "type": "string", "description": "Field id of a linked_record field on the base form (bare id, not a @pack: ref)." },
              "formId": { "type": "string", "description": "'@pack:<packFormId>' of the joined form." },
              "type": { "type": "string", "enum": ["inner", "left"] }
            }
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string", "description": "Bare field id (base form) or '@pack:<key>::<fieldId>' (joined form)." },
              "op": { "type": "string" },
              "value": {}
            }
          }
        },
        "groupBy": {
          "type": "object",
          "properties": {
            "field": { "type": "string" },
            "bucket": { "type": "string", "enum": ["none", "day", "month", "year"] }
          }
        },
        "measure": {
          "type": "object",
          "properties": {
            "fn": { "type": "string", "enum": ["count", "countDistinct", "sum", "avg", "min", "max"] },
            "field": { "type": "string" }
          }
        },
        "columns": { "type": "array", "items": { "type": "string" } },
        "seriesSort": { "type": "string", "enum": ["value", "label"] },
        "sort": { "description": "'asc'/'desc' (shorthand) or { by: fieldRef, dir: 'asc'|'desc' } (field sort)." },
        "having": {
          "type": "object",
          "properties": {
            "op": { "type": "string" },
            "value": { "type": "number" }
          }
        },
        "limit": { "type": "integer" }
      }
    },
    "packReportBlock": {
      "description": "A block inside a kind:'document' report item — free text or an embedded chart.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "body"],
          "properties": {
            "kind": { "const": "text" },
            "title": { "type": "string" },
            "body": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "reportId"],
          "properties": {
            "kind": { "const": "report" },
            "reportId": { "type": "string", "description": "Pack-local reportId of a sibling kind:'chart' item." },
            "caption": { "type": "string" }
          }
        }
      ]
    },
    "packReportItem": {
      "type": "object",
      "required": ["reportId", "kind", "name"],
      "description": "A pre-configured chart (kind:'chart', carries spec) or PDF document (kind:'document', carries blocks).",
      "properties": {
        "reportId": { "type": "string", "description": "Pack-local stable id. Referenced by document blocks and remapped to a real UUID on install." },
        "kind": { "type": "string", "enum": ["chart", "document"] },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "spec": { "$ref": "#/definitions/packReportSpec" },
        "blocks": { "type": "array", "items": { "$ref": "#/definitions/packReportBlock" } }
      }
    },
    "packApp": {
      "type": "object",
      "required": ["packAppId", "name"],
      "properties": {
        "packAppId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "logoUrl": { "type": ["string", "null"] },
        "settings": { "type": "object", "description": "landingPage may be a '@pack:<key>' ref; defaultRoleName is re-resolved on import." },
        "theme": { "type": "object" },
        "navConfig": {
          "type": "array",
          "items": { "type": "object", "properties": { "formId": { "type": "string", "description": "'@pack:<key>' or omitted for a non-form nav item." } } }
        },
        "customScreen": { "$ref": "#/definitions/customScreen" },
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["packFormId"],
            "properties": {
              "packFormId": { "type": "string" },
              "displayName": { "type": ["string", "null"] },
              "sortOrder": { "type": "integer" },
              "isVisible": { "type": "boolean" },
              "settings": { "type": "object" }
            }
          }
        },
        "roles": { "type": "array", "items": { "$ref": "#/definitions/role" } },
        "reports": {
          "type": "array",
          "description": "Optional pre-configured chart reports and PDF documents shown in the app's Reports section. The full array is capped at 256KB. @pack: refs in specs are remapped to real form ids on install; items with unresolvable refs are dropped.",
          "items": { "$ref": "#/definitions/packReportItem" }
        }
      }
    }
  }
}
